# Supabase — Project Settings → Data API / API Keys in the Supabase dashboard.
# Both of these are safe to expose to the browser; RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where password-reset links should land. Leave unset locally (defaults to the
# request origin); set it on Vercel to your deployed URL.
# NEXT_PUBLIC_SITE_URL=https://focusflow.vercel.app
